# Copy to .env and fill in. Never commit the real .env.

# Writable session/output directory (Render sets /tmp/pdfsplit-output).
OUTPUT_DIR=

# Shared-link gate for deployed demos. Unset = open (local). When set,
# visitors need /?k=<DEMO_TOKEN> once (sets a cookie); otherwise 404.
DEMO_TOKEN=

# Boundary reasoning trace on the server console + session/boundary_trace.txt.
# Default off. MUST stay off on Render (page text: vendors, GSTINs, amounts).
# Local: BOUNDARY_DEBUG=1 make dev
BOUNDARY_DEBUG=

# Upload hard cap (pages). Default 100.
MAX_UPLOAD_PAGES=100

# --- OpenRouter inference for the local web app ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# Scanned pages are sent as images in batches; native PDF text stays local.
OPENROUTER_MAX_IMAGES_PER_REQUEST=3
OPENROUTER_OCR_MAX_COMPLETION_TOKENS=220
OPENROUTER_MAX_COMPLETION_TOKENS=900
OPENROUTER_TIMEOUT_S=120
OPENROUTER_MIN_REQUEST_INTERVAL_S=0

# --- Mistral (legacy benchmarks / CLI) ---
# Bearer token for the Mistral OCR API. Get from console.mistral.ai.
MISTRAL_API_KEY=
# Per-page USD rates. OCR 4 is $4/1000 pages; Document AI (annotated) is $5/1000.
MISTRAL_OCR_USD_PER_PAGE=0.004
MISTRAL_DOCAI_USD_PER_PAGE=0.005
# Extraction mode: chat (default) or annotated (legacy single-call).
MISTRAL_EXTRACTION_MODE=chat
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_CHAT_CONCURRENCY=4
MISTRAL_CHAT_TIMEOUT_S=120
# Chat token rate estimates for cost_breakdown (USD per million tokens).
MISTRAL_CHAT_INPUT_USD_PER_MTOK=0.15
MISTRAL_CHAT_OUTPUT_USD_PER_MTOK=0.6

# Downstream AP hard page cap for adaptive batch packing (production is 12).
MAX_DOWNSTREAM_PAGES=12

# --- AI Accountant AP (Mode A upload) ---
# Live HTTP requires BOTH:
#   AIA_API_BASE=https://…   (explicit absolute URL)
#   AIA_ALLOW_WRITES=true    (explicit opt-in)
# Cookies: AIA_SESSION_COOKIES=<json array> OR .secrets/aia_session_cookies.json
# Never log cookie values. Never commit them.
AIA_API_BASE=
AIA_ALLOW_WRITES=false
AIA_SESSION_COOKIES=
# Bounded concurrent Mode A pushes (upload + HITL poll). Default 4.
AIA_PUSH_CONCURRENCY=4
